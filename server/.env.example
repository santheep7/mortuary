# Copy this file to .env and fill in your values

# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=mortuary_db

# Server
PORT=3001

# JWT signing secret — generate your own, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
